# ─────────────────────────────────────────────────────────────────────────────
# Colomer-Rifà Render AI — variables d'entorn
# Copia aquest fitxer a `.env` (arrel, per a docker compose) i/o `apps/web/.env`
# (per a `pnpm dev`). Mai pugis el `.env` al repositori.
# ─────────────────────────────────────────────────────────────────────────────

# Entorn: local | staging | production.
# L'accés de desenvolupament (AUTH_DEV_LOGIN) només s'accepta amb APP_ENV=local.
APP_ENV=local

# ── Base de dades ────────────────────────────────────────────────────────────
# Amb docker compose, DATABASE_URL es construeix a partir de POSTGRES_*.
POSTGRES_USER=cr
POSTGRES_PASSWORD=cr
POSTGRES_DB=colomer_rifa
DATABASE_URL=postgresql://cr:cr@localhost:5432/colomer_rifa

# Port publicat de la web amb docker compose.
WEB_PORT=3000

# ── Autenticació (Auth.js) ───────────────────────────────────────────────────
# Secret per signar les sessions. Genera'n un amb: openssl rand -base64 32
AUTH_SECRET=
# URL pública de l'aplicació.
AUTH_URL=http://localhost:3000

# Només es poden registrar adreces d'aquests dominis (separats per comes).
ALLOWED_EMAIL_DOMAINS=colomer-rifa.cat
# Administradors inicials (separats per comes). Sempre tenen rol admin.
ADMIN_EMAILS=

# Microsoft 365 / Entra ID (registre d'aplicació al tenant de l'empresa).
# Redirect URI a registrar: <AUTH_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<TENANT_ID>/v2.0  (tenant únic de l'empresa)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Accés de desenvolupament sense Microsoft (només APP_ENV=local). Mai en producció.
AUTH_DEV_LOGIN=true

# ── Serveis interns ──────────────────────────────────────────────────────────
CAD_SERVICE_URL=http://localhost:8000

# ── Generació de renders ─────────────────────────────────────────────────────
# Proveïdors d'IA. De moment només hi ha «mock» (proves: no fa servir cap IA i ho indica a la pantalla).
VISION_PROVIDER=mock
IMAGE_PROVIDER=mock
# El treballador de la cua s'executa dins del servidor web. «off» per a instàncies només web.
RENDER_WORKER=on

# Emmagatzematge de fitxers: local (S3 previst per al desplegament).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ── Fases següents (encara no s'utilitzen) ───────────────────────────────────
# Proveïdors reals (quan l'empresa triï i aporti les claus)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Fase 6 · Conversió DWG (ODA File Converter, opcional)
# ODA_FILE_CONVERTER_PATH=
# Fase 7 · Límits
# DAILY_BUDGET_PER_USER_EUR=
# RATE_LIMIT_GENERATIONS_PER_HOUR=
